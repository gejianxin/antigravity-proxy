{
  "_comment": "macOS x86_64 配置。字段与 bin/macos-arm64/config.json 相同。",
  "_version": "2.5-macos",
  "log_level": "info",
  "traffic_logging": false,
  "child_injection": true,
  "child_injection_mode": "filtered",
  "child_injection_exclude": ["git", "bash", "sh", "zsh"],
  "target_processes": [
    "Antigravity",
    "language_server",
    "language_server_macos",
    "agy",
    "node"
  ],
  "proxy": { "host": "127.0.0.1", "port": 7898, "type": "socks5" },
  "fake_ip": { "enabled": true, "cidr": "198.18.0.0/15" },
  "timeout": { "connect": 5000, "send": 5000, "recv": 5000 },
  "proxy_rules": {
    "allowed_ports": [80, 443],
    "dns_mode": "direct",
    "ipv6_mode": "proxy",
    "udp_mode": "auto",
    "udp_fallback": "block",
    "routing": {
      "enabled": true,
      "priority_mode": "order",
      "default_action": "proxy",
      "use_default_private": true,
      "rules": []
    }
  }
}
