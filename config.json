{
  "_comment": "Antigravity-Proxy Linux 配置文件 (支持 x64 与 arm64)。Windows 默认配置在 bin/windows-x64/config.json，字段相同。",
  "_version": "2.5-linux",
  "_build": {
    "platform": "linux",
    "supported_arch": ["x86_64", "aarch64"]
  },
  "log_level": "info",
  "traffic_logging": false,
  "diagnostics": {
    "agent_ip_probe": false
  },
  "child_injection": true,
  "child_injection_mode": "filtered",
  "child_injection_exclude": [
    "git",
    "bash",
    "sh",
    "which"
  ],
  "target_processes": [
    "antigravity",
    "language_server",
    "language_server_linux",
    "language_server_linux_x64",
    "language_server_linux_arm64",
    "agy",
    "node"
  ],
  "proxy": {
    "host": "127.0.0.1",
    "port": 7898,
    "type": "socks5"
  },
  "fake_ip": {
    "enabled": true,
    "cidr": "198.18.0.0/15"
  },
  "timeout": {
    "connect": 5000,
    "send": 5000,
    "recv": 5000
  },
  "proxy_rules": {
    "allowed_ports": [
      80,
      443
    ],
    "dns_mode": "direct",
    "ipv6_mode": "proxy",
    "udp_mode": "auto",
    "udp_fallback": "block",
    "routing": {
      "enabled": true,
      "priority_mode": "order",
      "default_action": "proxy",
      "use_default_private": true,
      "rules": []
    }
  }
}
